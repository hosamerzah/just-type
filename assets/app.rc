    BEGIN
      VALUE "FileDescription", "AutoKeyboard - offline Arabic/English keyboard\0"
      VALUE "ProductName", "AutoKeyboard\0"
      VALUE "ProductVersion", "0.2.0\0"
      VALUE "LegalCopyright", "AutoKeyboard contributors\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
